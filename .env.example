# Fonctionnement sans Supabase : laisser la clé publique vide, le catalogue local
# documenté reste disponible. Ne jamais committer de secrets.
# Vérifier le projet lodgicore autorisé dans le Dashboard avant de copier sa référence.
# Toutes nos tables résident dans le nouveau schéma maroc_en_chiffres, isolé de public.
SUPABASE_PROJECT_REF=vxuvjdskfmotauypkmav
NEXT_PUBLIC_SUPABASE_URL=https://vxuvjdskfmotauypkmav.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Une clé publique publishable peut remplacer ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Domaine public définitif pour canonical/hreflang/sitemap (aucun domaine inventé).
NEXT_PUBLIC_SITE_URL=
# Connexion PostgreSQL seulement pour l'opérateur exécutant les migrations.
# Copier la chaîne de connexion SSL depuis le projet vérifié, jamais dans Git.
SUPABASE_DB_URL=
